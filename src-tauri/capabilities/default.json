{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities for DSH Desktop",
  "windows": ["main", "dialog", "recovery", "profile-create", "devtools"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:default",
    "notification:default",
    "opener:default",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
